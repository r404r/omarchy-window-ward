#!/usr/bin/env python3
"""Window Ward's bounded, symlink-safe command interface."""
from __future__ import annotations

import errno
import fcntl
import fnmatch
import hashlib
import json
import os
import re
import selectors
import signal
import stat
import subprocess
import sys
import time
from contextlib import contextmanager
from pathlib import Path
from typing import Any, Iterator

MAX_CONFIG_BYTES = 48 * 1024
MAX_STATUS_BYTES = 64 * 1024
MAX_STATE_BYTES = 256
MAX_ACTIVE_WINDOW_BYTES = 32 * 1024
MAX_APPS = 128
MAX_ID_CHARS = 128
MAX_NAME_CHARS = 256
MAX_PATTERNS_PER_FIELD = 32
MAX_PATTERN_CHARS = 256
COMMAND_TIMEOUT_SECONDS = 3
ADDRESS_RE = re.compile(r"^(?:0x)?[0-9a-fA-F]+$")


class WardError(RuntimeError):
    pass


def die(message: str) -> None:
    raise WardError(message)


def is_testing() -> bool:
    return os.environ.get("WINDOW_WARD_TESTING") == "1"


def controlled_env_path(name: str, default: Path) -> Path:
    # Arbitrary file paths are only useful to the repository's test harness.
    return Path(os.environ[name]) if is_testing() and os.environ.get(name) else default


def config_path() -> Path:
    base = Path(os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config")))
    return controlled_env_path("WINDOW_WARD_CONFIG", base / "window-ward" / "config.json")


def state_path() -> Path:
    runtime = os.environ.get("XDG_RUNTIME_DIR")
    if not runtime:
        die("XDG_RUNTIME_DIR is required")
    return controlled_env_path("WINDOW_WARD_STATE", Path(runtime) / "window-ward" / "state")


def command_name(variable: str, default: str) -> str:
    return os.environ[variable] if is_testing() and os.environ.get(variable) else default


def has_control_characters(value: str) -> bool:
    return any(ord(character) < 32 or ord(character) == 127 for character in value)


def ensure_private_directory(directory: Path) -> int:
    """Open every ancestor without following links and create missing components."""
    absolute = Path(os.path.abspath(directory))
    directory_fd = os.open("/", os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    try:
        for component in absolute.parts[1:]:
            try:
                next_fd = os.open(component, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC | os.O_NOFOLLOW, dir_fd=directory_fd)
            except FileNotFoundError:
                try:
                    os.mkdir(component, 0o700, dir_fd=directory_fd)
                except FileExistsError:
                    pass
                next_fd = os.open(component, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC | os.O_NOFOLLOW, dir_fd=directory_fd)
            except OSError as error:
                if error.errno in (errno.ELOOP, errno.ENOTDIR):
                    die(f"refusing unsafe directory: {absolute}")
                die(f"cannot open configuration directory: {error.strerror}")
            os.close(directory_fd)
            directory_fd = next_fd
    except Exception:
        os.close(directory_fd)
        raise
    try:
        metadata = os.fstat(directory_fd)
        if not stat.S_ISDIR(metadata.st_mode) or metadata.st_uid != os.getuid():
            die(f"refusing unowned directory: {directory}")
        if metadata.st_mode & 0o077:
            os.fchmod(directory_fd, 0o700)
    except Exception:
        os.close(directory_fd)
        raise
    return directory_fd


def validate_regular_file(fd: int, label: str, max_bytes: int) -> os.stat_result:
    metadata = os.fstat(fd)
    if not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != os.getuid():
        die(f"refusing unsafe {label}")
    if metadata.st_mode & 0o022:
        die(f"refusing writable-by-others {label}")
    if metadata.st_size > max_bytes:
        die(f"{label} exceeds the {max_bytes}-byte limit")
    return metadata


class SecureStore:
    def __init__(self, path: Path, label: str, max_bytes: int) -> None:
        if path.name in ("", ".", ".."):
            die(f"invalid {label} path")
        self.name, self.label, self.max_bytes = path.name, label, max_bytes
        self.directory_fd = ensure_private_directory(path.parent)

    def close(self) -> None:
        os.close(self.directory_fd)

    @contextmanager
    def locked(self) -> Iterator[None]:
        lock_name = f"{self.name}.lock"
        try:
            lock_fd = os.open(lock_name, os.O_CREAT | os.O_RDWR | os.O_CLOEXEC | os.O_NOFOLLOW, 0o600, dir_fd=self.directory_fd)
        except OSError as error:
            if error.errno == errno.ELOOP:
                die(f"refusing symlinked {self.label} lock")
            die(f"cannot open {self.label} lock: {error.strerror}")
        try:
            validate_regular_file(lock_fd, f"{self.label} lock", 0)
            fcntl.flock(lock_fd, fcntl.LOCK_EX)
            yield
        finally:
            os.close(lock_fd)

    def read(self, missing_ok: bool = False) -> bytes | None:
        try:
            fd = os.open(self.name, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW, dir_fd=self.directory_fd)
        except FileNotFoundError:
            if missing_ok:
                return None
            die(f"{self.label} does not exist")
        except OSError as error:
            if error.errno == errno.ELOOP:
                die(f"refusing symlinked {self.label}")
            die(f"cannot open {self.label}: {error.strerror}")
        try:
            metadata = validate_regular_file(fd, self.label, self.max_bytes)
            remaining, chunks = metadata.st_size + 1, []
            while remaining:
                chunk = os.read(fd, min(8192, remaining))
                if not chunk:
                    break
                chunks.append(chunk)
                remaining -= len(chunk)
            contents = b"".join(chunks)
            if len(contents) > self.max_bytes:
                die(f"{self.label} exceeds the {self.max_bytes}-byte limit")
            return contents
        finally:
            os.close(fd)

    def write(self, contents: bytes) -> None:
        if len(contents) > self.max_bytes:
            die(f"{self.label} exceeds the {self.max_bytes}-byte limit")
        temporary = f".{self.name}.{os.urandom(12).hex()}.tmp"
        fd = os.open(temporary, os.O_CREAT | os.O_EXCL | os.O_WRONLY | os.O_CLOEXEC | os.O_NOFOLLOW, 0o600, dir_fd=self.directory_fd)
        try:
            offset = 0
            while offset < len(contents):
                offset += os.write(fd, contents[offset:])
            os.fsync(fd)
        except Exception:
            try:
                os.unlink(temporary, dir_fd=self.directory_fd)
            except FileNotFoundError:
                pass
            raise
        finally:
            os.close(fd)
        try:
            os.replace(temporary, self.name, src_dir_fd=self.directory_fd, dst_dir_fd=self.directory_fd)
            os.fsync(self.directory_fd)
        except Exception:
            try:
                os.unlink(temporary, dir_fd=self.directory_fd)
            except FileNotFoundError:
                pass
            raise

    def remove(self) -> None:
        try:
            fd = os.open(self.name, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW, dir_fd=self.directory_fd)
        except FileNotFoundError:
            return
        except OSError as error:
            if error.errno == errno.ELOOP:
                die(f"refusing symlinked {self.label}")
            die(f"cannot open {self.label}: {error.strerror}")
        try:
            validate_regular_file(fd, self.label, self.max_bytes)
        finally:
            os.close(fd)
        os.unlink(self.name, dir_fd=self.directory_fd)
        os.fsync(self.directory_fd)


DEFAULT_CONFIG: dict[str, Any] = {"schemaVersion": 1, "enabled": True, "confirmWindowMs": 3000, "protectedApplications": [{"id": "google-chrome", "name": "Google Chrome", "enabled": True, "mode": "double-press", "match": {"class": ["google-chrome", "chromium", "chrome-*"]}}]}


def validate_text(value: Any, field: str, maximum: int) -> str:
    if not isinstance(value, str) or not value or len(value) > maximum or has_control_characters(value):
        die(f"invalid {field}")
    return value


def validate_patterns(value: Any, field: str) -> list[str]:
    if value is None:
        return []
    if not isinstance(value, list) or len(value) > MAX_PATTERNS_PER_FIELD:
        die(f"invalid {field}")
    patterns = [validate_text(pattern, field, MAX_PATTERN_CHARS) for pattern in value]
    if any(not pattern.strip() for pattern in patterns):
        die(f"invalid {field}")
    return patterns


def validate_config(configuration: Any) -> dict[str, Any]:
    if not isinstance(configuration, dict) or configuration.get("schemaVersion") != 1:
        die("invalid configuration")
    enabled, timeout, applications = configuration.get("enabled"), configuration.get("confirmWindowMs"), configuration.get("protectedApplications")
    if not isinstance(enabled, bool) or type(timeout) is not int or not 100 <= timeout <= 999999 or not isinstance(applications, list) or len(applications) > MAX_APPS:
        die("invalid configuration")
    ids, normalized = set(), []
    for application in applications:
        if not isinstance(application, dict) or application.get("mode") != "double-press":
            die("invalid protected application")
        identifier = validate_text(application.get("id"), "application id", MAX_ID_CHARS)
        if identifier in ids:
            die("duplicate application id")
        ids.add(identifier)
        name = validate_text(application.get("name"), "application name", MAX_NAME_CHARS)
        if not isinstance(application.get("enabled"), bool) or not isinstance(application.get("match"), dict):
            die("invalid protected application")
        match = application["match"]
        classes, initial_classes = validate_patterns(match.get("class", []), "class match"), validate_patterns(match.get("initialClass", []), "initial class match")
        if not classes and not initial_classes:
            die("protected application needs a match")
        normalized.append({"id": identifier, "name": name, "enabled": application["enabled"], "mode": "double-press", "match": {"class": classes, "initialClass": initial_classes}})
    return {"schemaVersion": 1, "enabled": enabled, "confirmWindowMs": timeout, "protectedApplications": normalized}


def json_bytes(value: Any) -> bytes:
    return (json.dumps(value, ensure_ascii=False, separators=(",", ":")) + "\n").encode("utf-8")


def status_bytes(configuration: dict[str, Any]) -> bytes:
    contents = json_bytes(configuration)
    if len(contents) > MAX_STATUS_BYTES:
        die(f"status exceeds the {MAX_STATUS_BYTES}-byte limit")
    return contents


def load_config(store: SecureStore) -> dict[str, Any]:
    contents = store.read(missing_ok=True)
    if contents is None:
        store.write(json_bytes(DEFAULT_CONFIG))
        return DEFAULT_CONFIG
    try:
        return validate_config(json.loads(contents.decode("utf-8")))
    except (UnicodeDecodeError, json.JSONDecodeError):
        die("invalid configuration")


@contextmanager
def configuration() -> Iterator[tuple[SecureStore, dict[str, Any]]]:
    store = SecureStore(config_path(), "configuration", MAX_CONFIG_BYTES)
    try:
        with store.locked():
            yield store, load_config(store)
    finally:
        store.close()


def bounded_command(arguments: list[str], limit: int) -> bytes:
    try:
        process = subprocess.Popen(arguments, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError as error:
        die(f"cannot run {arguments[0]}: {error.strerror}")
    assert process.stdout is not None
    selector, output, deadline = selectors.DefaultSelector(), bytearray(), time.monotonic() + COMMAND_TIMEOUT_SECONDS
    selector.register(process.stdout, selectors.EVENT_READ)
    try:
        while True:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                die(f"{arguments[0]} timed out")
            events = selector.select(remaining)
            if not events:
                if process.poll() is not None:
                    break
                continue
            chunk = os.read(process.stdout.fileno(), min(8192, limit + 1 - len(output)))
            if not chunk:
                break
            output.extend(chunk)
            if len(output) > limit:
                die(f"{arguments[0]} output exceeds the {limit}-byte limit")
        if process.wait(timeout=max(0.1, deadline - time.monotonic())) != 0:
            die(f"{arguments[0]} failed")
    except WardError:
        try:
            os.killpg(process.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        process.wait()
        raise
    except subprocess.TimeoutExpired:
        try:
            os.killpg(process.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        process.wait(); die(f"{arguments[0]} timed out")
    finally:
        selector.close(); process.stdout.close()
    return bytes(output)


def quiet_command(arguments: list[str]) -> None:
    try:
        process = subprocess.Popen(arguments, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError as error:
        die(f"cannot run {arguments[0]}: {error.strerror}")
    try:
        return_code = process.wait(timeout=COMMAND_TIMEOUT_SECONDS)
        if return_code != 0:
            try:
                os.killpg(process.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            die(f"{arguments[0]} failed with exit status {return_code}")
    except subprocess.TimeoutExpired:
        try:
            os.killpg(process.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        process.wait()
        die(f"{arguments[0]} timed out")


def active_window() -> dict[str, str]:
    raw = bounded_command([command_name("WINDOW_WARD_HYPRCTL", "hyprctl"), "activewindow", "-j"], MAX_ACTIVE_WINDOW_BYTES)
    try:
        window = json.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError):
        die("hyprctl returned invalid active-window JSON")
    if not isinstance(window, dict) or not isinstance(window.get("address"), str) or not ADDRESS_RE.fullmatch(window["address"]):
        die("unexpected window address")
    result = {"address": window["address"]}
    for name in ("class", "initialClass"):
        value = window.get(name, "")
        result[name] = value if isinstance(value, str) and not has_control_characters(value) else ""
    return result


def matches(patterns: list[str], value: str) -> bool:
    return not patterns or any(fnmatch.fnmatchcase(value.lower(), pattern.lower()) for pattern in patterns)


def is_protected(config: dict[str, Any], window: dict[str, str]) -> bool:
    return any(application["enabled"] and matches(application["match"]["class"], window["class"]) and matches(application["match"]["initialClass"], window["initialClass"]) for application in config["protectedApplications"])


def close_window() -> None:
    with configuration() as (_store, config):
        window = active_window()
    hyprctl = command_name("WINDOW_WARD_HYPRCTL", "hyprctl")
    state = SecureStore(state_path(), "confirmation state", MAX_STATE_BYTES)
    try:
        if not config["enabled"] or not is_protected(config, window):
            with state.locked():
                state.remove()
            quiet_command([hyprctl, "eval", f'hl.dispatch(hl.dsp.window.close({{ window = "address:{window["address"]}" }}))'])
            return
        with state.locked():
            now, previous_address, previous_time = time.time_ns() // 1_000_000, "", 0
            contents = state.read(missing_ok=True)
            if contents:
                try:
                    parts = contents.decode("ascii").strip().split()
                    if len(parts) == 2 and ADDRESS_RE.fullmatch(parts[0]) and parts[1].isdigit():
                        previous_address, previous_time = parts[0], int(parts[1])
                except UnicodeDecodeError:
                    pass
            if window["address"] == previous_address and now - previous_time <= config["confirmWindowMs"]:
                state.remove()
                quiet_command([hyprctl, "eval", f'hl.dispatch(hl.dsp.window.close({{ window = "address:{window["address"]}" }}))'])
                return
            state.write(f'{window["address"]} {now}\n'.encode("ascii"))
        try:
            quiet_command([command_name("WINDOW_WARD_NOTIFY", "omarchy"), "notification", "send", "-u", "normal", "-t", str(config["confirmWindowMs"]), "Window Ward", f'Press Super+W again to close {window["class"]}'])
        except WardError:
            pass
    finally:
        state.close()


def slug_for_class(window_class: str) -> str:
    identifier = re.sub(r"[ _]+", "-", window_class.lower())
    identifier = re.sub(r"[^a-z0-9.-]", "", identifier).strip(".-")
    return identifier or f'app-{hashlib.sha256(window_class.encode("utf-8")).hexdigest()[:12]}'


def add_focused(name: str | None) -> None:
    window = active_window()
    if not window["class"]:
        die("focused window has no class")
    display_name, identifier = validate_text(name if name is not None else window["class"], "application name", MAX_NAME_CHARS), slug_for_class(window["class"])
    with configuration() as (store, config):
        applications = [application for application in config["protectedApplications"] if application["id"] != identifier]
        match: dict[str, list[str]] = {"class": [window["class"]], "initialClass": []}
        if window["initialClass"] and window["initialClass"] != window["class"]:
            match["initialClass"] = [window["initialClass"]]
        applications.append({"id": identifier, "name": display_name, "enabled": True, "mode": "double-press", "match": match})
        config["protectedApplications"] = applications
        store.write(json_bytes(validate_config(config)))
    print(f"Added {display_name} ({window['class']})")


def set_application_enabled(identifier: str, enabled: str) -> None:
    if not identifier:
        die("usage: window-ward set-app-enabled ID true|false")
    if enabled not in ("true", "false"):
        die("enabled must be true or false")
    with configuration() as (store, config):
        for application in config["protectedApplications"]:
            if application["id"] == identifier:
                application["enabled"] = enabled == "true"
                store.write(json_bytes(validate_config(config)))
                return
        die("unknown application id: " + identifier)


def remove_application(identifier: str) -> None:
    if not identifier:
        die("usage: window-ward remove ID")
    with configuration() as (store, config):
        applications = [application for application in config["protectedApplications"] if application["id"] != identifier]
        if len(applications) == len(config["protectedApplications"]):
            die("unknown application id: " + identifier)
        config["protectedApplications"] = applications
        store.write(json_bytes(validate_config(config)))


def main(arguments: list[str]) -> None:
    command = arguments[0] if arguments else "help"
    if command == "close": close_window()
    elif command == "status":
        with configuration() as (_store, config): sys.stdout.buffer.write(status_bytes(config))
    elif command == "list":
        with configuration() as (_store, config):
            for application in config["protectedApplications"]: print(f"{application['id']}\t{str(application['enabled']).lower()}\t{application['name']}\t{', '.join(application['match']['class'])}")
    elif command == "add-focused": add_focused(arguments[1] if len(arguments) > 1 else None)
    elif command == "set-app-enabled": set_application_enabled(arguments[1] if len(arguments) > 1 else "", arguments[2] if len(arguments) > 2 else "")
    elif command == "remove": remove_application(arguments[1] if len(arguments) > 1 else "")
    elif command in ("enable", "disable"):
        with configuration() as (store, config):
            config["enabled"] = command == "enable"; store.write(json_bytes(validate_config(config)))
    elif command == "timeout":
        if len(arguments) != 2 or not re.fullmatch(r"[1-9][0-9]{2,5}", arguments[1]): die("timeout must be 100-999999 milliseconds")
        with configuration() as (store, config):
            config["confirmWindowMs"] = int(arguments[1]); store.write(json_bytes(validate_config(config)))
    elif command == "doctor":
        with configuration(): pass
        bounded_command([command_name("WINDOW_WARD_HYPRCTL", "hyprctl"), "version"], 4096); print("config: ok\nhyprctl: ok")
    elif command in ("help", "-h", "--help"): print("Usage: window-ward {close|status|list|add-focused [NAME]|set-app-enabled ID true|false|remove ID|enable|disable|timeout MS|doctor}")
    else: die("unknown command: " + command)


if __name__ == "__main__":
    try: main(sys.argv[1:])
    except WardError as error:
        print(f"window-ward: {error}", file=sys.stderr); sys.exit(1)
