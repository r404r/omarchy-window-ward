#!/usr/bin/env bash
set -euo pipefail
umask 077
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
bin_dir=$HOME/.local/bin
if [[ ${WINDOW_WARD_TESTING:-} == 1 ]]; then bin_dir=${WINDOW_WARD_BIN_DIR:-$bin_dir}; fi
bindings=${WINDOW_WARD_BINDINGS:-$HOME/.config/hypr/bindings.lua}
begin='-- BEGIN WINDOW WARD (managed by setup)'
end='-- END WINDOW WARD'
cli="$bin_dir/window-ward"
block=$(printf '%s\nhl.unbind("SUPER + W")\no.bind("SUPER + W", "Close window safely", "%s close")\n%s' "$begin" "$cli" "$end")
[[ $cli != *'"'* && $cli != *\\* && $cli != *$'\n'* && $cli != *[[:space:]]* ]] || { echo 'Window Ward: install path cannot contain quotes, backslashes, or whitespace' >&2; exit 1; }
if [[ -e $cli || -L $cli ]]; then
  [[ -L $cli && $(readlink -f "$cli") == "$root/bin/window-ward" ]] || { echo "Window Ward: refusing to replace existing $cli" >&2; exit 1; }
fi
mkdir -p "$bin_dir" "${bindings%/*}"
WINDOW_WARD_CONFIG=${WINDOW_WARD_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/window-ward/config.json} "$root/bin/window-ward" status >/dev/null
[[ -e $bindings ]] || : >"$bindings"
begin_count=$(grep -Fxc -- "$begin" "$bindings" || true)
end_count=$(grep -Fxc -- "$end" "$bindings" || true)
if ((begin_count != end_count || begin_count > 1)); then echo 'Window Ward: malformed or duplicate managed block' >&2; exit 1; fi
if ((begin_count == 1)); then
  existing=$(sed -n "/^${begin//\//\\/}$/,/^${end//\//\\/}$/p" "$bindings")
  [[ $existing == "$block" ]] || { echo 'Window Ward: managed block was modified; refusing to overwrite it' >&2; exit 1; }
fi
if [[ -e $cli || -L $cli ]]; then
  link_created=false
else
  ln -s "$root/bin/window-ward" "$cli"
  link_created=true
fi
cleanup() { if [[ $link_created == true && -L $cli ]]; then rm -f -- "$cli"; fi; }
trap cleanup ERR
if ((begin_count == 0)); then
  cp -a "$bindings" "$bindings.window-ward-backup.$(date +%Y%m%d%H%M%S)"
  tmp=$(mktemp "${bindings}.XXXXXX")
  cat "$bindings" >"$tmp"
  printf '\n%s\n' "$block" >>"$tmp"
  chmod --reference="$bindings" "$tmp"
  mv -f "$tmp" "$bindings"
fi
trap - ERR
printf 'Window Ward installed. Run: hyprctl reload && hyprctl configerrors\n'
